# Life Easy API settings. Copy to `.env` for local development. NEVER commit real values.
# In production set these in the hosting secret store (Render > Environment), not in files.

# --- core ---------------------------------------------------------------------
ENVIRONMENT=development                 # development | test | production
FRONTEND_ORIGIN=http://localhost:3000   # the web dashboard origin (CORS + OAuth redirects back here)
PUBLIC_API_URL=http://localhost:8000    # public HTTPS URL of this API (OAuth callbacks, Telegram webhook)
LOG_LEVEL=INFO

# --- storage ------------------------------------------------------------------
# Local dev without Docker can use SQLite (tables are created on start):
DATABASE_URL=sqlite+aiosqlite:///./life_easy.db
# Docker / production: Postgres with pgvector, schema via `alembic upgrade head`
# DATABASE_URL=postgresql+asyncpg://life_easy:change_me@localhost:5432/life_easy
REDIS_URL=                              # empty = run background tasks inline (dev only); e.g. redis://localhost:6379/0
EMBEDDING_DIM=1024                      # must match the embedding model, fixed at first migration

# Private object storage for resumes (S3 / Cloudflare R2 / B2 / MinIO). Empty bucket = local folder.
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=                   # e.g. https://<account>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_LOCAL_DIR=./storage

# --- security -----------------------------------------------------------------
JWT_SECRET=dev-only-change-me           # production: random, >= 32 chars (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_ISSUER=life-easy
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
TOKEN_ENCRYPTION_KEY=                   # production: Fernet key (python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
RATE_LIMIT_PER_MINUTE=60

# --- AI -----------------------------------------------------------------------
LLM_PROVIDER=fake                       # fake (no key, placeholder answers) | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
EMBEDDING_PROVIDER=hash                 # hash (offline, rough) | voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
MAX_LLM_CALLS_PER_USER_PER_DAY=300

# --- messaging channels -------------------------------------------------------
WHATSAPP_WEBHOOK_VERIFY_TOKEN=          # any long random string; same value in the Meta webhook settings
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=                  # system-user token from Meta Business
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0
TELEGRAM_BOT_TOKEN=                     # from @BotFather
TELEGRAM_WEBHOOK_SECRET=                # any long random string (letters, digits, _ and -)

# --- email + LinkedIn OAuth apps -------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- job sources --------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Public company boards, comma separated provider:token (greenhouse, lever, ashby, workable, smartrecruiters)
JOB_BOARDS=greenhouse:stripe,lever:palantir,ashby:openai

# --- approvals ----------------------------------------------------------------
APPROVAL_TTL_HOURS=48
